{% extends 'layout/tool.html.twig' %}
{% import 'macros/_form.html.twig' as form %}

{% set tool_key = 'hp' %}
{% set tool_entry = 'htpasswd-generator' %}

{% set problems = ['row', 'user_empty', 'user_invalid', 'user_long', 'user_duplicate', 'password_empty', 'password_long'] %}

{% block tool %}
    {% set i18n = {
        copied: 'tool.copied'|trans,
        empty: 'hp.output.empty'|trans,
        busy: 'hp.output.busy'|trans,
        done: 'hp.output.done'|trans,
        failed: 'hp.output.failed'|trans,
        verify_empty: 'hp.verify.empty'|trans,
        verify_busy: 'hp.verify.busy'|trans,
        verify_match: 'hp.verify.match'|trans,
        verify_mismatch: 'hp.verify.mismatch'|trans,
        verify_unknown: 'hp.verify.unknown'|trans,
        verify_user: 'hp.verify.user'|trans,
        name_bcrypt: 'hp.name.bcrypt'|trans,
        name_apr1: 'hp.name.apr1'|trans,
        name_md5: 'hp.name.md5'|trans,
        name_sha: 'hp.name.sha'|trans,
    } %}
    {% for key in problems %}
        {% set i18n = i18n|merge({('problem_' ~ key): ('hp.problem.' ~ key)|trans}) %}
    {% endfor %}

    <div data-htpasswd-generator data-i18n="{{ i18n|json_encode|e('html_attr') }}">
        <div class="tool-tabs" role="tablist" aria-label="{{ 'hp.mode.label'|trans }}">
            <button type="button" class="tool-tabs__item active" role="tab" aria-selected="true" aria-controls="hp-panel-create" data-hp-mode="create">{{ 'hp.mode.create'|trans }}</button>
            <button type="button" class="tool-tabs__item" role="tab" aria-selected="false" aria-controls="hp-panel-verify" data-hp-mode="verify">{{ 'hp.mode.verify'|trans }}</button>
        </div>

        <div id="hp-panel-create" role="tabpanel" data-hp-panel="create">
            <form data-hp-form novalidate>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {{ form.select('algorithm', 'hp.field.algorithm'|trans, {
                            bcrypt: 'hp.algorithm.bcrypt'|trans,
                            apr1: 'hp.algorithm.apr1'|trans,
                            sha: 'hp.algorithm.sha'|trans,
                        }, {id: 'hp-algorithm', selected: 'bcrypt', wrapper_class: 'mb-1'}) }}
                        <p class="form-text mb-0" data-hp-hint="bcrypt">{{ 'hp.hint.bcrypt'|trans }}</p>
                        <p class="form-text mb-0" data-hp-hint="apr1" hidden>{{ 'hp.hint.apr1'|trans }}</p>
                    </div>

                    <div class="col-md-6" data-hp-cost-field>
                        <label class="form-label" for="hp-cost">{{ 'hp.field.cost'|trans }}</label>
                        <div class="tool-range">
                            <input class="form-range" id="hp-cost" name="cost" type="range" min="5" max="14" value="10" aria-describedby="hp-cost-hint">
                            <output for="hp-cost" data-hp-cost-value>10</output>
                        </div>
                        <p class="form-text mb-0" id="hp-cost-hint">{{ 'hp.field.cost_hint'|trans }}</p>
                    </div>
                </div>

                <p class="alert alert-warning" data-hp-hint="sha" hidden>{{ 'hp.hint.sha'|trans }}</p>

                <div class="hp-users" data-hp-users></div>

                <button type="button" class="btn btn-outline-primary btn-sm mt-3" data-hp-action="add">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    {{ 'hp.field.add'|trans }}
                </button>
            </form>

            <template data-hp-row-template>
                <div class="hp-user row g-2 align-items-end" data-hp-user>
                    <div class="col-12 col-sm-5">
                        <label class="form-label" data-hp-label="user">{{ 'hp.field.user'|trans }}</label>
                        <input class="form-control" name="user" type="text" placeholder="{{ 'hp.field.user_placeholder'|trans }}"
                               autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="255">
                    </div>
                    <div class="col">
                        <label class="form-label" data-hp-label="password">{{ 'hp.field.password'|trans }}</label>
                        <div class="input-group">
                            <input class="form-control hp-password" name="password" type="text" autocomplete="off" autocapitalize="off" spellcheck="false">
                            <button type="button" class="btn btn-outline-secondary hp-generate" data-hp-action="generate" aria-label="{{ 'hp.field.generate'|trans }}" title="{{ 'hp.field.generate'|trans }}">
                                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 11-1.6-3.9M13.5 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="hp-generate__text">{{ 'hp.field.generate_short'|trans }}</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-outline-secondary" data-hp-action="remove" aria-label="{{ 'hp.field.remove'|trans }}" title="{{ 'hp.field.remove'|trans }}">
                            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                        </button>
                    </div>
                </div>
            </template>

            <hr class="my-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <p class="form-label mb-0">{{ 'hp.output.title'|trans }}</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-hp-action="download">{{ 'hp.output.download'|trans }}</button>
                    <button type="button" class="btn btn-primary" data-hp-action="copy">{{ 'tool.copy'|trans }}</button>
                </div>
            </div>

            <div class="hp-status" data-hp-status hidden>
                <div class="hp-progress" role="progressbar" aria-label="{{ 'hp.output.progress'|trans }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-hp-progress>
                    <div class="hp-progress__bar"></div>
                </div>
            </div>
            <p class="visually-hidden" data-hp-announce aria-live="polite"></p>

            <ul class="hp-problems" data-hp-problems hidden></ul>
            <pre class="hp-output" data-hp-output tabindex="0" aria-label="{{ 'hp.output.title'|trans }}"></pre>

            <h2 class="hp-heading">{{ 'hp.config.title'|trans }}</h2>
            <p class="text-body-secondary">{{ 'hp.config.intro'|trans }}</p>

            <form class="row g-3 mb-3" data-hp-config novalidate>
                {{ form.input('realm', 'hp.config.realm'|trans, {id: 'hp-realm', value: 'hp.config.realm_default'|trans, autocomplete: 'off', wrapper_class: 'col-md-6'}) }}
                <div class="col-md-6">
                    <label class="form-label" for="hp-file">{{ 'hp.config.file'|trans }}</label>
                    <input class="form-control" id="hp-file" name="file" type="text" value="/var/www/.htpasswd" autocomplete="off" spellcheck="false" aria-describedby="hp-file-feedback">
                    <div class="invalid-feedback" id="hp-file-feedback">{{ 'hp.config.file_invalid'|trans }}</div>
                </div>
            </form>

            <div class="hp-configs">
                <div>
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <p class="form-label mb-0">{{ 'hp.config.apache'|trans }}</p>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-hp-action="copy-apache">{{ 'tool.copy'|trans }}</button>
                    </div>
                    <pre class="hp-output hp-output--config" data-hp-apache tabindex="0"></pre>
                    <p class="form-text">{{ 'hp.config.hint_apache'|trans }}</p>
                </div>

                <div>
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <p class="form-label mb-0">{{ 'hp.config.nginx'|trans }}</p>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-hp-action="copy-nginx">{{ 'tool.copy'|trans }}</button>
                    </div>
                    <pre class="hp-output hp-output--config" data-hp-nginx tabindex="0"></pre>
                    <p class="form-text">{{ 'hp.config.hint_nginx'|trans }}</p>
                </div>
            </div>
        </div>

        <div id="hp-panel-verify" role="tabpanel" data-hp-panel="verify" hidden>
            <p class="text-body-secondary">{{ 'hp.verify.intro'|trans }}</p>

            <form class="row g-3" data-hp-verify novalidate>
                <div class="col-12">
                    <label class="form-label" for="hp-line">{{ 'hp.verify.line'|trans }}</label>
                    <input class="form-control hp-line" id="hp-line" name="line" type="text" placeholder="admin:$2y$10$…"
                           autocomplete="off" autocapitalize="off" spellcheck="false">
                </div>
                {{ form.input('password', 'hp.verify.password'|trans, {id: 'hp-verify-password', autocomplete: 'off', wrapper_class: 'col-12'}) }}
            </form>

            <div class="hp-status mt-4" data-hp-verify-status hidden>
                <div class="hp-progress" role="progressbar" aria-label="{{ 'hp.output.progress'|trans }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-hp-verify-progress>
                    <div class="hp-progress__bar"></div>
                </div>
            </div>
            <p class="hp-verdict mt-4" data-hp-verdict aria-live="polite"></p>
        </div>
    </div>
{% endblock %}
