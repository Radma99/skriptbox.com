{% extends 'layout/tool.html.twig' %}
{% import 'macros/_form.html.twig' as form %}

{% set tool_key = 'pw' %}
{% set tool_entry = 'password-generator' %}

{% block tool %}
    <div data-password-generator data-i18n="{{ {
        copied: 'tool.copied'|trans,
        bits: 'pw.bits'|trans,
        strength_weak: 'pw.strength.weak'|trans,
        strength_medium: 'pw.strength.medium'|trans,
        strength_strong: 'pw.strength.strong'|trans,
        strength_very_strong: 'pw.strength.very_strong'|trans,
    }|json_encode|e('html_attr') }}">
        <div class="tool-tabs" role="tablist" aria-label="{{ 'pw.mode.label'|trans }}">
            <button type="button" class="tool-tabs__item active" role="tab" aria-selected="true" aria-controls="pw-panel-password" data-pw-mode="password">{{ 'pw.mode.password'|trans }}</button>
            <button type="button" class="tool-tabs__item" role="tab" aria-selected="false" aria-controls="pw-panel-passphrase" data-pw-mode="passphrase">{{ 'pw.mode.passphrase'|trans }}</button>
        </div>

        <div class="tool-output">
            <output class="tool-output__value" data-pw-output aria-live="polite" aria-label="{{ 'pw.result'|trans }}">–</output>
            <button type="button" class="btn btn-outline-secondary" data-pw-action="generate" aria-label="{{ 'pw.action.generate'|trans }}" title="{{ 'pw.action.generate'|trans }}">
                <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 11-1.6-3.9M13.5 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="btn btn-primary flex-grow-1 flex-sm-grow-0" data-pw-action="copy">{{ 'tool.copy'|trans }}</button>
        </div>

        <div class="pw-meter" data-pw-meter>
            <div class="pw-meter__bar" aria-hidden="true"></div>
            <p class="pw-meter__label" data-pw-meter-label></p>
        </div>

        <p class="alert alert-warning" data-pw-error hidden>{{ 'pw.error.no_charset'|trans }}</p>

        <form data-pw-form novalidate>
            <div id="pw-panel-password" role="tabpanel" data-pw-panel="password">
                <label class="form-label" for="pw-length">{{ 'pw.field.length'|trans }}</label>
                <div class="tool-range mb-3">
                    <input class="form-range" id="pw-length" name="length" type="range" min="8" max="64" value="20">
                    <output for="pw-length" data-range-value="length">20</output>
                </div>

                <div class="row">
                    {{ form.switch('upper', 'pw.field.upper'|trans, {id: 'pw-upper', checked: true, wrapper_class: 'col-sm-6 mb-2'}) }}
                    {{ form.switch('lower', 'pw.field.lower'|trans, {id: 'pw-lower', checked: true, wrapper_class: 'col-sm-6 mb-2'}) }}
                    {{ form.switch('digits', 'pw.field.digits'|trans, {id: 'pw-digits', checked: true, wrapper_class: 'col-sm-6 mb-2'}) }}
                    {{ form.switch('symbols', 'pw.field.symbols'|trans, {id: 'pw-symbols', checked: true, wrapper_class: 'col-sm-6 mb-2'}) }}
                    {{ form.switch('avoidAmbiguous', 'pw.field.avoid_ambiguous'|trans, {id: 'pw-ambiguous', wrapper_class: 'col-12 mb-2'}) }}
                </div>
            </div>

            <div id="pw-panel-passphrase" role="tabpanel" data-pw-panel="passphrase" hidden>
                <label class="form-label" for="pw-words">{{ 'pw.field.words'|trans }}</label>
                <div class="tool-range mb-3">
                    <input class="form-range" id="pw-words" name="words" type="range" min="3" max="10" value="7">
                    <output for="pw-words" data-range-value="words">7</output>
                </div>

                {{ form.select('separator', 'pw.field.separator'|trans, {
                    '-': 'pw.separator.dash'|trans,
                    '.': 'pw.separator.dot'|trans,
                    '_': 'pw.separator.underscore'|trans,
                    ' ': 'pw.separator.space'|trans,
                    '': 'pw.separator.none'|trans,
                }, {id: 'pw-separator', selected: '-'}) }}

                <div class="row">
                    {{ form.switch('capitalize', 'pw.field.capitalize'|trans, {id: 'pw-capitalize', checked: true, wrapper_class: 'col-sm-6 mb-2'}) }}
                    {{ form.switch('addNumber', 'pw.field.add_number'|trans, {id: 'pw-number', checked: true, wrapper_class: 'col-sm-6 mb-2'}) }}
                </div>
            </div>
        </form>
    </div>
{% endblock %}
